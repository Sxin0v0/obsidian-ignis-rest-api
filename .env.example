IGNIS_LOCAL_REST_API_KEY=YOUR_API_KEY
# Optional when multiple vaults enable the plugin:
IGNIS_LOCAL_REST_API_DEFAULT_VAULT=YOUR_VAULT_ID
# Optional CORS origin restriction:
IGNIS_LOCAL_REST_API_CORS_ORIGIN=https://app.example.com
# Optional diagnostics:
IGNIS_LOCAL_REST_API_VERBOSE=false
IGNIS_LOCAL_REST_API_BRIDGE_TIMEOUT_MS=5000
